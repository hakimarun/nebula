# Copy this file to ".env" (same folder as docker-compose.yml) and fill in the
# values. .env is git-ignored so your token never lands in the repo.

# Timezone for the container
TZ=Europe/Berlin

# --- Automatic updates from your PRIVATE repo (optional) ---------------------
# Leave these empty to just run the version baked into the image.
#
# Create a *fine-grained* Personal Access Token limited to this one repo with
# read-only "Contents" permission:  https://github.com/settings/tokens?type=beta
REPO_URL=https://github.com/hakimarun/nebula.git
REPO_BRANCH=main
GITHUB_TOKEN=
