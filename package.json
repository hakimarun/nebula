{
  "name": "nebula-server",
  "version": "1.0.0",
  "description": "NEBULA - self-hosted media server (movies, series, music, images)",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "build": "cd client && npm install && npm run build",
    "setup": "npm install && npm run build"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "castv2": "^0.1.10",
    "castv2-client": "^1.2.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multicast-dns": "^7.2.5",
    "nodemailer": "^6.9.13"
  }
}
